# À ajouter à l’environnement existant du backend.
# Générer une valeur aléatoire de 32 caractères minimum, différente de JWT_SECRET.
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DEVELOPMENT_JWT_SECRET=

# Source facultative de l import initial en base (migration ou commande explicite).
# Les connexions utilisent exclusivement la table development_directory_access.
# Exemple : +243810000000,+243820000000
DEVELOPMENT_DIRECTORY_PHONES=

# Origines supplémentaires de la nouvelle application, séparées par des virgules.
# localhost:5173 et 127.0.0.1:5173 sont déjà autorisés pour le développement.
DEVELOPMENT_CORS_ORIGINS=

# Facultatif : base PostgreSQL temporaire pour les tests d’intégration.
# Son nom doit commencer par development_test. Ne pas utiliser une base réelle.
# DEVELOPMENT_TEST_DATABASE_URL=postgresql://test_user:test_password@127.0.0.1:55432/development_test
